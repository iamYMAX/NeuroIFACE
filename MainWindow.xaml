<Window x:Class="NeuroIFACE.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MainWindow" Height="450" Width="800" SizeToContent="WidthAndHeight" MouseDown="Window_MouseDown" Opacity="0.8" AllowsTransparency="True" Background="Transparent" Topmost="True" WindowStartupLocation="CenterOwner" WindowStyle="None" MouseRightButtonDown="Window_MouseRightButtonDown"  ResizeMode="NoResize">
    <Window.Resources>
        <Style TargetType="Button" x:Key="ModernButtonStyle">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#44FFFFFF"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Border Background="#B3000000" CornerRadius="15" BorderThickness="2" Name="MainBorder" MouseEnter="MainBorder_MouseEnter" MouseLeave="MainBorder_MouseLeave">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="NEiroInerFace" Grid.Row="0"
                       HorizontalAlignment="Center" VerticalAlignment="Center"
                       FontSize="24" FontWeight="Bold" Foreground="White" Margin="10"/>

            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="5">
                <Button x:Name="MinimizeButton" Content="_" Click="MinimizeButton_Click" Visibility="Collapsed" Style="{StaticResource ModernButtonStyle}"/>
                <Button x:Name="CloseButton" Content="X" Click="CloseButton_Click" Visibility="Collapsed" Style="{StaticResource ModernButtonStyle}" Margin="5,0,0,0"/>
            </StackPanel>

            <TextBlock Text="{Binding CurrentPhrase}" Grid.Row="2"
                       HorizontalAlignment="Center" VerticalAlignment="Bottom"
                       FontSize="{Binding FontSize}" TextWrapping="Wrap" Margin="10" Foreground="White" Opacity="1"/>
        </Grid>
    </Border>
</Window>
