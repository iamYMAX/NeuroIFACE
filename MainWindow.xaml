<Window x:Class="NeuroIFACE.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MainWindow" Height="450" Width="800" SizeToContent="WidthAndHeight" MouseDown="Window_MouseDown" Opacity="0.8" AllowsTransparency="True" Background="Transparent" Topmost="True" WindowStartupLocation="CenterOwner" WindowStyle="None" MouseRightButtonDown="Window_MouseRightButtonDown"  ResizeMode="NoResize" MouseDoubleClick="Window_MouseDoubleClick">
    <Border Background="#B3000000" CornerRadius="15"  BorderThickness="2" >
        <Grid >
            <TextBlock Text="{Binding CurrentPhrase}" 
                   HorizontalAlignment="Center" VerticalAlignment="Bottom" 
                   FontSize="{Binding FontSize}" TextWrapping="Wrap" Margin="5" Foreground="White" Opacity="1"/>
        </Grid>
    </Border>
</Window>
