<Window x:Class="NeuroIFACE.PhraseManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:NeuroIFACE"
        mc:Ignorable="d"
        Title="Phrase Manager" Height="450" Width="600"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen">
    <Border BorderBrush="#FF5E5E5E" BorderThickness="1" CornerRadius="10" Background="#FF2D2D2D">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/> <!-- Title Bar -->
                <RowDefinition Height="*"/> <!-- Content -->
                <RowDefinition Height="Auto"/> <!-- Buttons -->
            </Grid.RowDefinitions>

            <!-- Custom Title Bar (Optional, for consistent look with no WindowStyle) -->
            <Grid Grid.Row="0" Background="#FF3C3C3C" MouseDown="TitleBar_MouseDown" Height="30">
                <TextBlock Text="Phrase Manager" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="White" FontSize="14"/>
                <Button x:Name="CloseButtonTitle" Content="X" HorizontalAlignment="Right" VerticalAlignment="Center" Width="30" Height="30"
                        Background="Transparent" Foreground="White" BorderThickness="0" Click="CloseButton_Click"
                        Style="{StaticResource {x:Static ToolBar.ButtonStyleKey}}"/>
            </Grid>

            <ListView x:Name="PhrasesListView" Grid.Row="1" Margin="10" Background="#FF3C3C3C" Foreground="White" SelectionMode="Extended">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Russian" Width="250" DisplayMemberBinding="{Binding Russian}"/>
                        <GridViewColumn Header="English" Width="250" DisplayMemberBinding="{Binding English}"/>
                    </GridView>
                </ListView.View>
            </ListView>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="10">
                <Button x:Name="DeleteButton" Content="Delete Selected" Margin="5" Width="100" Height="30" Click="DeleteButton_Click" Style="{StaticResource ModernButtonStyle}"/>
                <Button x:Name="ClearAllButton" Content="Clear All" Margin="5" Width="100" Height="30" Click="ClearAllButton_Click" Style="{StaticResource ModernButtonStyle}"/>
                <Button x:Name="ImportButton" Content="Import from Excel" Margin="5" Width="120" Height="30" Click="ImportButton_Click" Style="{StaticResource ModernButtonStyle}"/>
                <Button x:Name="ExportButton" Content="Export to Excel" Margin="5" Width="120" Height="30" Click="ExportButton_Click" Style="{StaticResource ModernButtonStyle}"/>
                <Button x:Name="CloseButton" Content="Close" Margin="5" Width="100" Height="30" Click="CloseButton_Click" Style="{StaticResource ModernButtonStyle}"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
