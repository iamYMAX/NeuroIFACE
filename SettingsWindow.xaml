<Window x:Class="NeuroIFACE.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки" Height="Auto" MaxHeight="600" Width="314" WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True" Background="Transparent" Topmost="True" Foreground="White" SizeToContent="Height">
    <Border Background="#B3000000" CornerRadius="25" BorderThickness="2">
        <Grid>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel x:Name="MainStackPanel" Orientation="Vertical" Margin="15">

                    <Expander Header="Ввод и перевод фраз" Margin="0,0,0,10" IsExpanded="True">
                        <StackPanel Margin="5">
                            <TextBlock Text="Тексты для перевода:" Margin="0,0,0,5" FontSize="14" FontWeight="SemiBold"/>
                            <TextBox x:Name="RussianTextBox" Height="30" ToolTip="Введите 1е значение" Background="{x:Null}" Foreground="#FFFDFBFB" FontSize="18" TextChanged="RussianTextBox_TextChanged" Margin="0,0,0,5"/>
                            <TextBox x:Name="EnglishTextBox" Height="30" ToolTip="Введите 2е Значение" Background="{x:Null}" Foreground="White" FontSize="16" TextChanged="EnglishTextBox_TextChanged" Margin="0,0,0,10"/>
                        </StackPanel>
                    </Expander>

                    <Expander Header="Отображение фраз" Margin="0,0,0,10" IsExpanded="True">
                        <StackPanel Margin="5">
                            <TextBlock Text="Частота обновления фразы (Навязчивость):" Margin="0,0,0,5" FontSize="14" FontWeight="SemiBold"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Slider Minimum="1" Maximum="25" Value="{Binding SliderValue, Mode=TwoWay}" Width="150" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding SliderValue, StringFormat={}{0:F0}}" FontSize="16" Foreground="White" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>

                            <TextBlock Text="Размер шрифта фраз:" Margin="0,0,0,5" FontSize="14" FontWeight="SemiBold"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Slider Minimum="8" Maximum="24" Value="{Binding FontSize, Mode=TwoWay}" Width="150" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding FontSize, Mode=TwoWay, StringFormat={}{0:F0}}" FontSize="16" Foreground="White" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Expander>

                    <Expander Header="Внешний вид главного окна" Margin="0,0,0,10" IsExpanded="True">
                        <StackPanel Margin="5">
                            <!-- This TextBlock seems redundant if the Expander has a similar header, but kept for consistency with original structure -->
                            <TextBlock Text="Вид главного окна:" Margin="0,0,0,5" FontSize="14" FontWeight="SemiBold" Visibility="Collapsed"/>

                            <TextBlock Text="Цвет фона гл. окна:" Foreground="White" Margin="0,0,0,5"/>
                            <StackPanel Orientation="Vertical" Margin="0,0,0,10">
                                <!-- Red Slider -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                    <TextBlock Text="R:" Foreground="White" Width="20" VerticalAlignment="Center"/>
                                    <Slider x:Name="RedSlider" Minimum="0" Maximum="255" Value="34" Width="150" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="RgbSlider_ValueChanged" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding ElementName=RedSlider, Path=Value, StringFormat={}{0:F0}}" Foreground="White" Width="30" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <!-- Green Slider -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                                    <TextBlock Text="G:" Foreground="White" Width="20" VerticalAlignment="Center"/>
                                    <Slider x:Name="GreenSlider" Minimum="0" Maximum="255" Value="34" Width="150" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="RgbSlider_ValueChanged" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding ElementName=GreenSlider, Path=Value, StringFormat={}{0:F0}}" Foreground="White" Width="30" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <!-- Blue Slider -->
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                                    <TextBlock Text="B:" Foreground="White" Width="20" VerticalAlignment="Center"/>
                                    <Slider x:Name="BlueSlider" Minimum="0" Maximum="255" Value="34" Width="150" TickFrequency="1" IsSnapToTickEnabled="True" ValueChanged="RgbSlider_ValueChanged" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding ElementName=BlueSlider, Path=Value, StringFormat={}{0:F0}}" Foreground="White" Width="30" Margin="5,0,0,0" VerticalAlignment="Center"/>
                                </StackPanel>
                                <!-- Color Preview -->
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Предпросмотр:" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <Rectangle x:Name="ColorPreviewRectangle" Width="50" Height="30" Stroke="Gray" StrokeThickness="1" Fill="#FF222222"/>
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Text="Прозрачность гл. окна:" Foreground="White" Margin="0,0,0,5"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <Slider x:Name="OpacitySlider" Minimum="0.1" Maximum="1.0" Value="{Binding MainWindowOpacity, Mode=TwoWay}"
                                        SmallChange="0.05" TickFrequency="0.1" Width="150" VerticalAlignment="Center"/>
                                <TextBlock Text="{Binding ElementName=OpacitySlider, Path=Value, StringFormat={}{0:F2}}" Foreground="White" Margin="10,0,0,0" VerticalAlignment="Center"/>
                            </StackPanel>
                        </StackPanel>
                    </Expander>

                    <Expander Header="Управление данными и действия" Margin="0,0,0,10" IsExpanded="True">
                        <StackPanel Margin="5">
                            <Button x:Name="ManagePhrasesButton"
                                    Content="Управление списком фраз"
                                    Click="ManagePhrasesButton_Click"
                                    Margin="0,5,0,10"
                                    Style="{StaticResource ModernButtonStyle}"/>

                            <Grid Margin="0,10,0,0">
                                 <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/> <!-- Add Phrase Button -->
                                    <ColumnDefinition Width="*"/> <!-- Spacer -->
                                    <ColumnDefinition Width="Auto"/> <!-- Close Button -->
                                </Grid.ColumnDefinitions>

                                <Button Content="Добавить фразу"
                                        Grid.Column="0"
                                        Click="AddPhrase_Click"
                                        Style="{StaticResource ModernButtonStyle}"/>

                                <Button Grid.Column="2" Width="30" Height="30" Background="#FF080808" Click="CloseButton_Click" ToolTip="Закрыть настройки" HorizontalAlignment="Right">
                                    <TextBlock Text="✕" FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="White"/>
                                </Button>
                            </Grid>
                        </StackPanel>
                    </Expander>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
