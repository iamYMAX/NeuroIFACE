<Window x:Class="NeuroIFACE.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки" Height="360" Width="314"  WindowStyle="None" ResizeMode="NoResize"  AllowsTransparency="True" Background="Transparent" Topmost="True" SizeToContent="WidthAndHeight" Foreground="White">
    <Border Background="#B3000000" CornerRadius="25"  BorderThickness="2"  >
        <Grid >
            <!-- Кнопка закрытия -->
            <Button Width="50" Height="50" Background="#FF080808" BorderBrush="Transparent" 
                HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,300,250,0" Click="CloseButton_Click">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <!-- Круглая форма кнопки -->
                            <Ellipse Fill="{TemplateBinding Background}" />

                            <!-- Крестик внутри кнопки -->
                            <Grid RenderTransformOrigin="0.5,0.5">
                                <!-- Анимация вращения -->
                                <Grid.RenderTransform>
                                    <RotateTransform x:Name="rotateTransform" Angle="0" />
                                </Grid.RenderTransform>

                                <!-- Вертикальная линия крестика -->
                                <Rectangle Width="2" Height="20" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <!-- Горизонтальная линия крестика -->
                                <Rectangle Width="20" Height="2" Fill="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Grid>
                        </Grid>

                        <!-- Триггер для анимации вращения при наведении -->
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="rotateTransform" Storyboard.TargetProperty="Angle"
                                                         To="360" Duration="0:0:0.5" RepeatBehavior="Forever" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetName="rotateTransform" Storyboard.TargetProperty="Angle"
                                                         To="0" Duration="0:0:0.5" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            <Slider Minimum="1" Maximum="25" Value="{Binding SliderValue, Mode=TwoWay}" 
        HorizontalAlignment="Center" VerticalAlignment="Top" 
        Width="100" Margin="0,120,0,0" />
            <TextBlock Text="{Binding SliderValue}" 
           HorizontalAlignment="Center"  VerticalAlignment="Top" Margin="0,94,0,0"
           FontSize="16" Foreground="White"/>
            <TextBox x:Name="RussianTextBox" Height="30" Margin="26,10,25,0" 
                 VerticalAlignment="Top" ToolTip="Введите 1е значение" Background="{x:Null}" Foreground="#FFFDFBFB" FontSize="18" TextChanged="RussianTextBox_TextChanged"/>
            <TextBox x:Name="EnglishTextBox" Height="30" Margin="26,55,25,0" 
                 VerticalAlignment="Top" ToolTip="Введите 2е Значение" Background="{x:Null}" Foreground="White" FontSize="16" TextChanged="EnglishTextBox_TextChanged"/>
            <Button Content="Добавить" Background="#FF080808" Foreground="White" FontSize="16" BorderThickness="2" BorderBrush="Transparent" Click="AddPhrase_Click" Margin="219,137,19,30">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <!-- Фон кнопки -->
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="45">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </Grid>

                        <!-- Анимации -->
                        <ControlTemplate.Triggers>
                            <!-- Триггер на наведение мыши -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <!-- Анимация масштаба при наведении -->
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.1" Duration="0:0:0.2" />
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.1" Duration="0:0:0.2" />
                                            <ColorAnimation Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="White" Duration="0:0:0.2" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>

                                <!-- Анимация возврата при уходе курсора -->
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.2" />
                                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.2" />
                                            <ColorAnimation Storyboard.TargetProperty="(Border.BorderBrush).(SolidColorBrush.Color)" To="Transparent" Duration="0:0:0.2" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>

                <!-- Трансформация для изменения масштаба -->
                <Button.RenderTransform>
                    <ScaleTransform ScaleX="1" ScaleY="1" />
                </Button.RenderTransform>
            </Button>

            <TextBlock Text="{Binding FontSize, Mode=TwoWay}"  FontSize="16" Margin="0,132,0,71" HorizontalAlignment="Center" Foreground="White" Width="30"/>
            <!-- Слайдер для изменения размера шрифта -->
            <Slider Minimum="8" Maximum="24" Value="{Binding FontSize, Mode=TwoWay}" HorizontalAlignment="Center" VerticalAlignment="Top" 
Width="100" Margin="0,152,0,0" />
            <Label Content="Накрут" Margin="52,116,210,98" Foreground="White"/>
            <Label Content="Навязчивость" Margin="119,174,105,40" Foreground="White"/>

            <!-- Main Window Background Color Label -->
            <TextBlock Text="Цвет фона гл. окна:"
                       HorizontalAlignment="Left" VerticalAlignment="Top"
                       Margin="26,200,0,0" Foreground="White"/>

            <!-- Predefined Color Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="26,220,0,0">
                <Button x:Name="ColorButtonDarkGray" Content="Темно-серый" Margin="0,0,5,0" Background="#FF222222" Foreground="White" Click="ColorButton_Click" Tag="#FF222222" Padding="5,2"/>
                <Button x:Name="ColorButtonDarkBlue" Content="Темно-синий" Margin="0,0,5,0" Background="#FF222244" Foreground="White" Click="ColorButton_Click" Tag="#FF222244" Padding="5,2"/>
                <Button x:Name="ColorButtonDarkGreen" Content="Темно-зеленый" Margin="0,0,0,0" Background="#FF224422" Foreground="White" Click="ColorButton_Click" Tag="#FF224422" Padding="5,2"/>
            </StackPanel>

            <!-- Main Window Opacity Label -->
            <TextBlock Text="Прозрачность гл. окна:"
                       HorizontalAlignment="Left" VerticalAlignment="Top"
                       Margin="26,255,0,0" Foreground="White"/>

            <!-- Opacity Slider -->
            <Slider x:Name="OpacitySlider" Minimum="0.1" Maximum="1.0" Value="{Binding MainWindowOpacity, Mode=TwoWay}"
                    SmallChange="0.05" TickFrequency="0.1"
                    HorizontalAlignment="Left" VerticalAlignment="Top"
                    Width="150" Margin="26,275,0,0" />

            <!-- Opacity Value Display -->
            <TextBlock Text="{Binding ElementName=OpacitySlider, Path=Value, StringFormat={}{0:F2}}"
                       HorizontalAlignment="Left" VerticalAlignment="Top"
                       Margin="186,275,0,0" Foreground="White"/>
        </Grid>
    </Border>
</Window>
